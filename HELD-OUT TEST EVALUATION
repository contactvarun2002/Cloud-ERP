import ast

from IPython import get_ipython

# Find the original Step 3 cell in this Colab runtime.
required_functions = {"classification_results", "select_on_validation"}
step3_source = None

for cell in reversed(get_ipython().user_ns.get("In", [])):
    try:
        tree = ast.parse(cell)
    except SyntaxError:
        continue

