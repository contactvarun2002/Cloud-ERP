        node.name for node in tree.body if isinstance(node, ast.FunctionDef)
    }
    if required_functions <= function_names and "plot_supplied_ibm_matrices" not in function_names:
        step3_source = cell
        break

if step3_source is None:
    raise RuntimeError(
        "This runtime has no record of the original Step 3 cell. "
        "Run your original Step 3 cell in this notebook, then run this cell."
    )

