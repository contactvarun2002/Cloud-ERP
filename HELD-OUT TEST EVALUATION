    '        save_figure(fig, folder / "Confusion_Matrix.png")\n\n'
    '        fig, ax = plt.subplots(figsize=(7, 5))'
)
summary_start = 'write_json(OUT / "Step3_Summary.json", {'

for marker in (matrix_start, matrix_end, summary_start):
    if step3_source.count(marker) != 1:
        raise RuntimeError(
            "The Step 3 cell in this runtime differs from the validation-tuning version."
        )

step3_source = step3_source.replace(
    matrix_start,
    matrix_start.replace("if make_plots:", 'if make_plots and dataset != "IBM_HR":'),
    1,
)
step3_source = step3_source.replace(
